{
  "name": "pofis",
  "version": "0.7.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "bun --bun next build",
    "start": "bun --bun next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "desktop": "bun scripts/electron/launch.cjs",
    "desktop:install": "bun node_modules/electron/install.js",
    "desktop:prepare": "bun run desktop:install && bun scripts/electron/build.cjs",
    "desktop:package": "bun run desktop:prepare && bun scripts/electron/package.cjs",
    "test:desktop": "bun test ./electron ./src/desktop",
    "test:desktop:distribution": "bun scripts/electron/distribution-test.cjs",
    "test:desktop:smoke": "bun scripts/electron/smoke.cjs"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "geist": "1.7.2",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tough-cookie": "6.0.0"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "43.8.1",
    "typescript": "7.0.2"
  }
}
